rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users Collection: allow read and write so registrations, profiles, and ban statuses persist
    match /users/{userId} {
      allow read, write: if true;
    }

    // Stores Collection: allow vendors and admin to create and update stores
    match /stores/{storeId} {
      allow read, write: if true;
    }

    // Products Collection: allow product listing, stock changes, and admin moderation
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders Collection: allow buyers to place orders and admin/vendors to update/delete
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Withdrawals Collection: allow vendor withdrawal requests and admin approval
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    // Audit Logs Collection: append-only immutable logs
    match /auditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Global Settings & Marketplace Configuration
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // System Health & Diagnostics
    match /system_health/{docId} {
      allow read, write: if true;
    }

    // Fallback match for any subcollections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

